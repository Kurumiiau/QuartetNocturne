# ============================================================
#  二进制资源：禁止任何行尾 / 编码转换
#  （避免 git 在 checkout 时损坏图片、字体、音频）
# ============================================================
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.mp3   binary
*.wav   binary
*.ogg   binary
*.mp4   binary

# ============================================================
#  Windows 批处理必须是 CRLF，否则 cmd.exe 可能解析异常
# ============================================================
*.bat   text eol=crlf
*.cmd   text eol=crlf
